# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED. Bearer token for the INAPROC/LKPP API. Every route returns HTTP 500
# without it. Obtained from LKPP; rotate here when it expires.
JWT_TOKEN=

# Root of the local data store. Each dataset is written here as three files:
#   <root>/v1/rup/master-satker_2025.json   <- canonical
#   <root>/v1/rup/master-satker_2025.csv
#   <root>/v1/rup/master-satker_2025.xlsx
# Defaults to ./DATA inside the project when unset.
INAPROC_DATA_PATH=D:\INAPROC-Data

# KLPD (institution) code sent as ?kode_klpd= on every request. Determines whose
# procurement data you receive. Defaults to K34.
INAPROC_KODE_KLPD=K34

# KLPD type sent as ?jenis= on dashboard endpoints:
#   1=Kementerian  2=Lembaga  3=Provinsi  4=Kabupaten  5=Kota
# Must describe the same institution as INAPROC_KODE_KLPD. Omitting it makes
# dashboard/*/geo/eselon and geo/satker return zero items. Defaults to 1.
INAPROC_KLPD_JENIS=1

# Upstream API base URL. Only change this to point at a mirror or a mock.
INAPROC_API_BASE_URL=https://data.inaproc.id/api
